<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="@color/goatai_purple_deep"
                android:endColor="@color/goatai_electric_dim" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="@color/goatai_purple"
                android:endColor="@color/goatai_electric" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</selector>
