<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/goatai_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <!-- ── Toolbar ────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="@color/goatai_fg"
                android:textSize="22sp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Settings"
                android:textColor="@color/goatai_fg_strong"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- ── JT808 Server ──────────────────────────────────────── -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="JT808 SIGNALLING SERVER" />

        <LinearLayout style="@style/SettingsCard">

            <TextView style="@style/SettingsFieldLabel" android:text="Host / IP Address" />
            <EditText
                android:id="@+id/etJt808Host"
                style="@style/SettingsEditText"
                android:inputType="textUri"
                android:hint="e.g. 192.168.1.10" />

            <View style="@style/SettingsDivider" />

            <TextView style="@style/SettingsFieldLabel" android:text="TCP Port" />
            <EditText
                android:id="@+id/etJt808Port"
                style="@style/SettingsEditText"
                android:inputType="number"
                android:hint="6808" />
        </LinearLayout>

        <!-- ── RTVS / JT1078 Server ──────────────────────────────── -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="RTVS / JT1078 MEDIA SERVER" />

        <LinearLayout style="@style/SettingsCard">

            <TextView style="@style/SettingsFieldLabel" android:text="Host / IP Address" />
            <EditText
                android:id="@+id/etRtvsHost"
                style="@style/SettingsEditText"
                android:inputType="textUri"
                android:hint="e.g. 192.168.1.10" />

            <View style="@style/SettingsDivider" />

            <TextView style="@style/SettingsFieldLabel" android:text="TCP Port" />
            <EditText
                android:id="@+id/etRtvsPort"
                style="@style/SettingsEditText"
                android:inputType="number"
                android:hint="6600" />
        </LinearLayout>

        <!-- ── Terminal Identity ─────────────────────────────────── -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="TERMINAL IDENTITY" />

        <LinearLayout style="@style/SettingsCard">

            <TextView style="@style/SettingsFieldLabel" android:text="SIM Phone Number  (12 digits)" />
            <EditText
                android:id="@+id/etPhone"
                style="@style/SettingsEditText"
                android:inputType="phone"
                android:maxLength="12"
                android:hint="000000000001" />

            <View style="@style/SettingsDivider" />

            <TextView style="@style/SettingsFieldLabel" android:text="Terminal ID  (max 7 chars)" />
            <EditText
                android:id="@+id/etTerminalId"
                style="@style/SettingsEditText"
                android:inputType="text"
                android:maxLength="7"
                android:hint="GOATAI1" />
        </LinearLayout>

        <!-- ── Vehicle Registration ──────────────────────────────── -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="VEHICLE REGISTRATION" />

        <LinearLayout style="@style/SettingsCard" android:layout_marginBottom="28dp">

            <TextView style="@style/SettingsFieldLabel"
                android:text="VIN / License Plate  (used in 0x0100 registration)" />
            <EditText
                android:id="@+id/etVin"
                style="@style/SettingsEditText"
                android:inputType="textCapCharacters"
                android:maxLength="17"
                android:hint="GOATAI0000000001" />

            <View style="@style/SettingsDivider" />

            <!-- Informational note — plate colour is 0 (unregistered) until overridden via 0x8103 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="Plate colour: 0 (unregistered) — configurable via 0x8103 param 0x0084"
                android:textColor="@color/goatai_muted"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- ── Save button ───────────────────────────────────────── -->
        <TextView
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/btn_save"
            android:gravity="center"
            android:text="SAVE AND RESTART"
            android:textColor="@color/goatai_fg_strong"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:textColor="@color/goatai_warn"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
